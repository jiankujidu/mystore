#!/bin/bash
# MyStore 端口服务模式启动脚本 (fnOS)
# fnOS 不会预装 python3：必须在 manifest 用 install_dep_apps=python312 声明依赖，
# 依赖二进制在 /var/apps/python312/target/bin/python3（不在 PATH），需自行定位。

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_DIR="${TRIM_APPDEST}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# ---------- 端口解析 ----------
DEFAULT_PORT=8011
PORT="${TRIM_SERVICE_PORT:-$DEFAULT_PORT}"
[ -z "$PORT" ] && PORT="$DEFAULT_PORT"
if [ -n "$TRIM_PKGVAR" ] && [ -f "${TRIM_PKGVAR}/config/resource" ]; then
    P=$(grep -oE '"port"[[:space:]]*:[[:space:]]*[0-9]+' "${TRIM_PKGVAR}/config/resource" 2>/dev/null \
        | grep -oE '[0-9]+' | head -1)
    [ -n "$P" ] && PORT="$P"
fi
[ -n "$APP_PORT" ] && PORT="$APP_PORT"
log_msg "PORT=${PORT}"

# ---------- 服务目录探测（网页在 TRIM_APPDEST/www）----------
SERVE_DIR=""
for cand in "${APP_DIR}/www" "${APP_DIR}/app/www" "/var/apps/mystore/target/www" "/var/apps/mystore/www"; do
    if [ -n "$cand" ] && [ -f "${cand}/index.html" ]; then
        SERVE_DIR="$cand"
        break
    fi
done
if [ -z "$SERVE_DIR" ]; then
    SERVE_DIR=$(find "${APP_DIR}" -name index.html -path '*/www/*' 2>/dev/null | head -1 | xargs -r dirname 2>/dev/null)
fi
log_msg "SERVE_DIR=${SERVE_DIR}"

# ---------- 定位 python（依赖应用 python312 提供）----------
PYTHON=""
for cand in /var/apps/python312/target/bin/python3 /var/apps/python3*/target/bin/python3 /usr/bin/python3 python3; do
    if [ -x "$cand" ] || command -v "$cand" >/dev/null 2>&1; then
        PYTHON="$cand"
        break
    fi
done
log_msg "PYTHON=${PYTHON:-NONE}"

start_process() {
    if status; then
        log_msg "already running"
        return 0
    fi
    if [ -z "$PYTHON" ]; then
        echo "未找到 python 运行时。请在 manifest 声明 install_dep_apps=python312 并确保依赖已安装。" > "${TRIM_TEMP_LOGFILE}"
        log_msg "ERROR: python runtime not found"
        return 1
    fi
    if [ -z "$SERVE_DIR" ] || [ ! -f "${SERVE_DIR}/index.html" ]; then
        echo "MyStore 网页目录未找到 (SERVE_DIR=${SERVE_DIR})。" > "${TRIM_TEMP_LOGFILE}"
        log_msg "ERROR: SERVE_DIR missing index.html"
        return 1
    fi
    log_msg "Starting: ${PYTHON} -m http.server ${PORT} --bind 0.0.0.0 --directory ${SERVE_DIR}"
    # setsid 脱离会话，避免 cmd/main 退出后被 fnOS 杀掉；exec 使 PID 即 python 进程
    setsid bash -c "exec ${PYTHON} -m http.server ${PORT} --bind 0.0.0.0 --directory ${SERVE_DIR}" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    log_msg "launched pid=$!"
    return 0
}

stop_process() {
    log_msg "Stopping process ..."
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi
        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> "${LOG_FILE}" 2>&1
        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done
        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ] && check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
