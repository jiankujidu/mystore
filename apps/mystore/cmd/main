#!/bin/bash
# MyStore 端口服务模式启动脚本 (fnOS)
# 运行时优先级：busybox httpd（fnOS 自带，最可靠）→ python3 → node → busybox nc
# 任一可用即把 www/index.html 以 0.0.0.0:PORT 暴露出来，不依赖任何外部运行时。

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_DIR="${TRIM_APPDEST}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null
}

# ---------- 端口解析 ----------
DEFAULT_PORT=8011
PORT="${TRIM_SERVICE_PORT:-$DEFAULT_PORT}"
[ -z "$PORT" ] && PORT="$DEFAULT_PORT"
if [ -n "$TRIM_PKGVAR" ] && [ -f "${TRIM_PKGVAR}/config/resource" ]; then
    P=$(grep -oE '"port"[[:space:]]*:[[:space:]]*[0-9]+' "${TRIM_PKGVAR}/config/resource" 2>/dev/null \
        | grep -oE '[0-9]+' | head -1)
    [ -n "$P" ] && PORT="$P"
fi
[ -n "$APP_PORT" ] && PORT="$APP_PORT"
log_msg "PORT=${PORT}"

# ---------- 服务目录探测（网页在 TRIM_APPDEST/www）----------
SERVE_DIR=""
for cand in "${APP_DIR}/www" "${APP_DIR}/app/www" "/var/apps/mystore/target/www" "/var/apps/mystore/www"; do
    if [ -n "$cand" ] && [ -f "${cand}/index.html" ]; then
        SERVE_DIR="$cand"
        break
    fi
done
if [ -z "$SERVE_DIR" ]; then
    SERVE_DIR=$(find "${APP_DIR}" -name index.html -path '*/www/*' 2>/dev/null | head -1 | xargs -r dirname 2>/dev/null)
fi
log_msg "SERVE_DIR=${SERVE_DIR:-NONE}"

# ---------- 运行时定位（覆盖 fnOS 所有常见路径） ----------
locate_python3() {
    for cand in /usr/bin/python3 /usr/local/bin/python3 \
                /var/apps/python3*/target/bin/python3 \
                /opt/py311/bin/python3 /mnt/app/py39/bin/python3 \
                /usr/bin/python3.11 /usr/bin/python3.10 /usr/bin/python3.8; do
        if [ -x "$cand" ]; then echo "$cand"; return 0; fi
        if command -v "$cand" >/dev/null 2>&1; then echo "$cand"; return 0; fi
    done
    # fnOS 底层 Debian，python3 通常已在 PATH
    if command -v python3 >/dev/null 2>&1; then echo "python3"; return 0; fi
    return 1
}

locate_busybox_httpd() {
    # fnOS 自带 busybox，几乎一定编译进了 httpd applet
    for cand in /usr/bin/busybox /usr/sbin/busybox /bin/busybox /sbin/busybox; do
        if [ -x "$cand" ]; then
            # 探测 httpd 是否可用（不实际运行）
            if "${cand}" httpd --help >/dev/null 2>&1; then
                echo "$cand"; return 0
            fi
        fi
    done
    if command -v busybox >/dev/null 2>&1 && busybox httpd --help >/dev/null 2>&1; then
        echo "busybox"; return 0
    fi
    return 1
}

locate_node() {
    for cand in /var/apps/nodejs_v*/target/bin/node \
                /usr/local/bin/node /usr/bin/node node; do
        if [ -x "$cand" ]; then echo "$cand"; return 0; fi
        if command -v "$cand" >/dev/null 2>&1; then echo "$cand"; return 0; fi
    done
    return 1
}

# ---------- 启动 ----------
DETACH="setsid"
command -v setsid >/dev/null 2>&1 || DETACH="nohup"

launch() {
    local cmd="$1"
    "${DETACH}" bash -c "echo \$\$ > '${PID_FILE}'; exec ${cmd}" >> "${LOG_FILE}" 2>&1 &
    sleep 0.3
    if [ -s "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}" 2>/dev/null)" 2>/dev/null; then
        log_msg "launched pid=$(cat "${PID_FILE}") backend=[$2]"
        return 0
    fi
    log_msg "launch FAILED backend=[$2]: ${cmd}"
    return 1
}

start_process() {
    if status; then
        log_msg "already running"
        return 0
    fi
    if [ -z "$SERVE_DIR" ] || [ ! -f "${SERVE_DIR}/index.html" ]; then
        echo "MyStore 网页目录未找到 (SERVE_DIR=${SERVE_DIR})。" > "${TRIM_TEMP_LOGFILE}"
        log_msg "ERROR: SERVE_DIR missing index.html"
        return 1
    fi

    # 1) busybox httpd（fnOS 自带，最可靠）
    BB=$(locate_busybox_httpd 2>/dev/null)
    if [ -n "$BB" ]; then
        # 前台模式（-f）便于 PID 管理
        launch "${BB} httpd -f -p ${PORT} -h ${SERVE_DIR}" "busybox-httpd" && return 0
    fi

    # 2) python3（fnOS 底层 Debian 自带 Python 3.11.2）
    PY=$(locate_python3 2>/dev/null)
    if [ -n "$PY" ]; then
        launch "${PY} -m http.server ${PORT} --bind 0.0.0.0 --directory ${SERVE_DIR}" "python3" && return 0
    fi

    # 3) node（依赖应用装在 /var/apps/nodejs_vXX/target/bin/）
    NODE=$(locate_node 2>/dev/null)
    if [ -n "$NODE" ]; then
        local srv="${TRIM_PKGVAR}/serve.js"
        cat > "${srv}" <<'EOF'
const http=require('http'),fs=require('fs'),path=require('path');
const dir=process.argv[2]||'.',port=process.argv[3]||8011;
const MIME={'html':'text/html; charset=utf-8','htm':'text/html; charset=utf-8','css':'text/css','js':'application/javascript','json':'application/json','png':'image/png','jpg':'image/jpeg','jpeg':'image/jpeg','gif':'image/gif','svg':'image/svg+xml','ico':'image/x-icon','woff':'font/woff','woff2':'font/woff2'};
http.createServer((q,s)=>{
  let u=q.url==='/'?'index.html':q.url.replace(/^\//,'');
  if(u.includes('..')||u.includes('|')||u.includes('&')||u.includes('`')){s.statusCode=400;s.end('Bad Request');return;}
  const F=path.join(dir,u),ext=F.split('.').pop().toLowerCase(),ct=MIME[ext]||'application/octet-stream';
  try{const b=fs.readFileSync(F);s.setHeader('Content-Type',ct);s.setHeader('Content-Length',b.length);s.end(b);}
  catch(e){s.statusCode=404;s.end('404 Not Found');}
}).listen(port,'0.0.0.0',()=>{});
EOF
        launch "${NODE} ${srv} ${SERVE_DIR} ${PORT}" "node" && return 0
    fi

    # 4) busybox nc 兜底（fnOS 自带 busybox 几乎一定带 nc）
    NC=""
    for cand in /usr/bin/nc /usr/sbin/nc /bin/nc nc; do
        if [ -x "$cand" ]; then NC="$cand"; break; fi
        if command -v "$cand" >/dev/null 2>&1; then NC="$cand"; break; fi
    done
    if [ -n "$NC" ]; then
        local srv_sh="${TRIM_PKGVAR}/serve.sh"
        cat > "${srv_sh}" <<'SH'
#!/bin/sh
# 极简 HTTP server：busybox nc 轮询监听 + sh，零外部依赖
PORT="${2:-8011}"
DIR="${1:-.}"
serve_one() {
    REQ="$1"
    case "$REQ" in
        "GET "*|"HEAD "*|"POST "*)
            URL="${REQ#* }"; URL="${URL%% *}"
            [ "$URL" = "/" ] && URL="/index.html"
            case "$URL" in
                *'..'*|*'|'*|*'&'*|*'`'*)
                    printf 'HTTP/1.1 400 Bad Request\r\nContent-Length: 11\r\n\r\nBad Request'
                    ;;
                *)
                    F="${DIR}${URL}"
                    if [ -f "$F" ]; then
                        case "${F##*.}" in
                            html|htm) CT="text/html; charset=utf-8" ;;
                            css) CT="text/css" ;;
                            js) CT="application/javascript" ;;
                            json) CT="application/json" ;;
                            png) CT="image/png" ;;
                            jpg|jpeg) CT="image/jpeg" ;;
                            gif) CT="image/gif" ;;
                            svg) CT="image/svg+xml" ;;
                            ico) CT="image/x-icon" ;;
                            woff|woff2) CT="font/woff2" ;;
                            *) CT="application/octet-stream" ;;
                        esac
                        SZ=$(wc -c < "$F" | tr -d '[:space:]')
                        printf 'HTTP/1.1 200 OK\r\nContent-Type: %s\r\nContent-Length: %s\r\n\r\n' "$CT" "$SZ"
                        cat "$F"
                    else
                        printf 'HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\n\r\n404'
                    fi
                    ;;
            esac
            ;;
        *)
            ;;
    esac
}
while true; do
    RESP=$(serve_one "$(nc -l -p "$PORT" -q 0 2>/dev/null)")
    [ -n "$RESP" ] && printf '%s' "$RESP" > /dev/null
    sleep 0.1
done
SH
        launch "${SH} ${srv_sh} ${SERVE_DIR} ${PORT}" "sh-nc" && return 0
    fi

    echo "未找到任何可用运行时（busybox httpd / python3 / node / nc）。请检查 fnOS 基础环境。" > "${TRIM_TEMP_LOGFILE}"
    log_msg "ERROR: no runtime available (busybox-httpd/python3/node/nc all missing)"
    return 1
}

stop_process() {
    log_msg "Stopping process ..."
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        log_msg "pid=${pid}"
        # 同时杀整棵进程树：setsid 起的 httpd/python/node 可能有子进程，
        # 或 PID_FILE 记的是 setsid 父进程而非真正 listen 的进程。
        # 用 pkill -P 递归杀子进程 + kill 父，再按端口兜底。
        kill_tree() {
            local p=$1
            [ -z "$p" ] && return
            # 递归杀子进程
            for c in $(pgrep -P "$p" 2>/dev/null); do
                kill_tree "$c"
            done
            kill -TERM "$p" 2>/dev/null
        }
        if [ -n "$pid" ] && check_process "${pid}"; then
            kill_tree "${pid}"
            local count=0
            while check_process "${pid}" && [ $count -lt 10 ]; do
                sleep 1
                count=$((count + 1))
                log_msg "waiting process terminal... (${count}s/10s)"
            done
            if check_process "${pid}"; then
                log_msg "send KILL signal to PID:${pid}..."
                kill -KILL "${pid}" 2>/dev/null
                for c in $(pgrep -P "${pid}" 2>/dev/null); do kill -KILL "$c" 2>/dev/null; done
                sleep 1
            fi
        fi
        # 端口兜底：谁还在 listen PORT 就杀掉（避免卸载后残留）
        pkill -f "httpd.*${PORT}" 2>/dev/null
        pkill -f "http.server.*${PORT}" 2>/dev/null
        pkill -f "serve.js.*${PORT}" 2>/dev/null
        pkill -f "serve.sh.*${PORT}" 2>/dev/null
        rm -f "${PID_FILE}"
        log_msg "port=${PORT} pkill fallback done"
    fi
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ] && check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
