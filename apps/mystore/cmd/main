#!/bin/bash
# MyStore 端口服务模式启动脚本 (fnOS)
# 不依赖任何外部运行时：优先 python3，其次 busybox httpd（fnOS 自带），
# 再次 node；任一可用即把网页 www/index.html 以 0.0.0.0:PORT 暴露出来。
# 这样即便 python312 依赖未安装，商店也能正常起服务。

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_DIR="${TRIM_APPDEST}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null
}

# ---------- 端口解析 ----------
DEFAULT_PORT=8011
PORT="${TRIM_SERVICE_PORT:-$DEFAULT_PORT}"
[ -z "$PORT" ] && PORT="$DEFAULT_PORT"
if [ -n "$TRIM_PKGVAR" ] && [ -f "${TRIM_PKGVAR}/config/resource" ]; then
    P=$(grep -oE '"port"[[:space:]]*:[[:space:]]*[0-9]+' "${TRIM_PKGVAR}/config/resource" 2>/dev/null \
        | grep -oE '[0-9]+' | head -1)
    [ -n "$P" ] && PORT="$P"
fi
[ -n "$APP_PORT" ] && PORT="$APP_PORT"
log_msg "PORT=${PORT}"

# ---------- 服务目录探测（网页在 TRIM_APPDEST/www）----------
SERVE_DIR=""
for cand in "${APP_DIR}/www" "${APP_DIR}/app/www" "/var/apps/mystore/target/www" "/var/apps/mystore/www"; do
    if [ -n "$cand" ] && [ -f "${cand}/index.html" ]; then
        SERVE_DIR="$cand"
        break
    fi
done
if [ -z "$SERVE_DIR" ]; then
    SERVE_DIR=$(find "${APP_DIR}" -name index.html -path '*/www/*' 2>/dev/null | head -1 | xargs -r dirname 2>/dev/null)
fi
log_msg "SERVE_DIR=${SERVE_DIR:-NONE}"

# ---------- 运行时定位 ----------
locate_python() {
    for cand in /var/apps/python312/target/bin/python3 /var/apps/python3*/target/bin/python3 /usr/bin/python3 python3; do
        if [ -x "$cand" ] || command -v "$cand" >/dev/null 2>&1; then echo "$cand"; return 0; fi
    done
    return 1
}
locate_busybox() {
    for cand in /bin/busybox /sbin/busybox busybox; do
        if [ -x "$cand" ]; then echo "$cand"; return 0; fi
        if command -v "$cand" >/dev/null 2>&1; then echo "$cand"; return 0; fi
    done
    return 1
}
locate_node() {
    for cand in /var/apps/nodejs_v22/target/bin/node /var/apps/nodejs*/target/bin/node /usr/bin/node node; do
        if [ -x "$cand" ] || command -v "$cand" >/dev/null 2>&1; then echo "$cand"; return 0; fi
    done
    return 1
}

# 选择脱离方式：优先 setsid（新会话，避免被 fnOS 杀掉），否则 nohup
DETACH="setsid"
command -v setsid >/dev/null 2>&1 || DETACH="nohup"

# 启动：在独立会话里 exec 命令，并把真实 PID 写入 PID_FILE
launch() {
    local cmd="$1"
    "${DETACH}" bash -c "echo \$\$ > '${PID_FILE}'; exec ${cmd}" >> "${LOG_FILE}" 2>&1 &
    sleep 0.3
    if [ -s "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}" 2>/dev/null)" 2>/dev/null; then
        log_msg "launched pid=$(cat "${PID_FILE}") backend=[$2]"
        return 0
    fi
    log_msg "launch FAILED backend=[$2]: ${cmd}"
    return 1
}

start_process() {
    if status; then
        log_msg "already running"
        return 0
    fi
    if [ -z "$SERVE_DIR" ] || [ ! -f "${SERVE_DIR}/index.html" ]; then
        echo "MyStore 网页目录未找到 (SERVE_DIR=${SERVE_DIR})。" > "${TRIM_TEMP_LOGFILE}"
        log_msg "ERROR: SERVE_DIR missing index.html"
        return 1
    fi

    # 1) python3
    PY=$(locate_python 2>/dev/null)
    if [ -n "$PY" ]; then
        launch "${PY} -m http.server ${PORT} --bind 0.0.0.0 --directory ${SERVE_DIR}" "python" && return 0
    fi

    # 2) busybox httpd（fnOS 自带，无需外部依赖）
    BB=$(locate_busybox 2>/dev/null)
    if [ -n "$BB" ] && "${BB}" --list 2>/dev/null | grep -qx httpd; then
        launch "${BB} httpd -f -p ${PORT} -h ${SERVE_DIR}" "busybox-httpd" && return 0
    fi

    # 3) node 兜底（生成极小静态服务器脚本）
    NODE=$(locate_node 2>/dev/null)
    if [ -n "$NODE" ]; then
        local srv="${TRIM_PKGVAR}/serve.js"
        cat > "${srv}" <<'EOF'
const http=require('http'),fs=require('fs'),path=require('path');
const dir=process.argv[2]||'.',port=process.argv[3]||8011;
http.createServer((q,s)=>{
  let u=q.url==='/'?'index.html':q.url.replace(/^\//,'');
  try{s.end(fs.readFileSync(path.join(dir,u)));}
  catch(e){s.statusCode=404;s.end('404');}
}).listen(port,'0.0.0.0',()=>{});
EOF
        launch "${NODE} ${srv} ${SERVE_DIR} ${PORT}" "node" && return 0
    fi

    echo "未找到任何可用运行时（python3 / busybox httpd / node）。请检查 fnOS 基础环境。" > "${TRIM_TEMP_LOGFILE}"
    log_msg "ERROR: no runtime available"
    return 1
}

stop_process() {
    log_msg "Stopping process ..."
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi
        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> "${LOG_FILE}" 2>&1
        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done
        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ] && check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
